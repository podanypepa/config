# Pruhlednost (napr. video v prohlizeci za terminalem); prepinac: cmd+shift+o
# Okno startuje pruhledne, toggle prepina na nepruhledne a zpet.
# Zmena opacity vyzaduje uplny restart Ghostty.
background-opacity = 0.4
background-blur = false
keybind = cmd+shift+o=toggle_background_opacity

# [FULLSCREEN SETUP] mensi padding = vic mista (puvodne x=10, y=10)
window-padding-x = 4
window-padding-y = 2
window-padding-balance = true

font-family = "SauceCodePro Nerd Font"
font-family-bold = "SauceCodePro Nerd Font"
font-family-italic = "SauceCodePro Nerd Font"
font-family-bold-italic = "SauceCodePro Nerd Font"

font-feature = -calt, -liga, -dlig

window-title-font-family = "SauceCodePro Nerd Font"

# Quick terminal: rozbalovaci terminal odkudkoli (vyzaduje Accessibility povoleni)
keybind = global:cmd+grave_accent=toggle_quick_terminal
# keybind = shift+left=previous_tab
# keybind = shift+right=next_tab
# keybind = alt+left=goto_split:previous
# keybind = alt+right=goto_split:next
# keybind = alt+left=goto_split:previous
# keybind = alt+right=goto_split:next
# keybind = alt+up=goto_split:previous
# keybind = alt+down=goto_split:next
# keybind = cmd+f=toggle_fullscreen

# https://ghostty.org/docs/config/reference#macos-non-native-fullscreen
# macos-non-native-fullscreen = true
shell-integration = zsh

auto-update = check
window-save-state = always
focus-follows-mouse = true
#
# split-separator-color = red
auto-update-channel = tip
# window-decoration = false
# macos-titlebar-style = hidden
#
# https://www.ditig.com/publications/256-colors-cheat-sheet
split-divider-color = #444444

window-new-tab-position = current

cursor-style = block
cursor-style-blink = false
# ssh-terminfo: na server nainstaluje xterm-ghostty terminfo, ssh-env: fallback TERM
shell-integration-features = no-cursor,ssh-terminfo,ssh-env

confirm-close-surface = false
scrollbar = never

# ============================================================
# [FULLSCREEN SETUP] max plocha, bez Ghostty tabu, vse pres tmux windows
# ============================================================
# Zadna lista (Ghostty taby nejsou videt, pouzij tmux windows)
macos-titlebar-style = hidden

# Okno startuje ve fullscreenu
fullscreen = true

# Ne-nativni fullscreen: okamzity, bez animace a vlastniho Space; padded-notch = obsah pod notchem
macos-non-native-fullscreen = padded-notch

# Prepinani fullscreenu (vychozi binding, jen explicitne)
keybind = cmd+enter=toggle_fullscreen

# Levy Option jako Alt/Meta pro tmux/vim, pravy Option dal pise specialni znaky
macos-option-as-alt = left

# Cmd zkratky ovladaji tmux: posilaji prefix (Ctrl+a = \x01) + klavesu.
# Mimo tmux (quick terminal) nedavaji smysl.
keybind = cmd+t=text:\x01c
keybind = cmd+w=text:\x01x
keybind = cmd+d=text:\x01v
keybind = cmd+shift+d=text:\x01s
keybind = cmd+k=text:\x01f
keybind = cmd+shift+enter=text:\x01z
keybind = cmd+shift+bracket_left=text:\x01p
keybind = cmd+shift+bracket_right=text:\x01n
keybind = cmd+digit_1=text:\x011
keybind = cmd+digit_2=text:\x012
keybind = cmd+digit_3=text:\x013
keybind = cmd+digit_4=text:\x014
keybind = cmd+digit_5=text:\x015
keybind = cmd+digit_6=text:\x016
keybind = cmd+digit_7=text:\x017
keybind = cmd+digit_8=text:\x018
keybind = cmd+digit_9=text:\x019

